# ---- Vertex AI / Gemini ----
GCP_PROJECT=your-project-id
GCP_LOCATION=global

# Task-based model routing (confirm exact IDs in Vertex AI -> Model Garden)
GEMINI_MODEL_LITE=gemini-2.5-flash-lite   # tagging, news summaries
GEMINI_MODEL=gemini-2.5-flash             # chat, follow-ups, coach, plans
GEMINI_MODEL_PRO=gemini-2.5-pro           # evaluator, resume/JD-tailored plans
EMBEDDING_MODEL=gemini-embedding-001

# ---- Learn Hub ingestion (python -m ingest.run) ----
YOUTUBE_API_KEY=              # YouTube Data API v3 key (Google Cloud console -> APIs & Services)
GITHUB_TOKEN=                 # optional; raises GitHub search rate limits
# "Find resources now": empty = run in a local thread (dev); Cloud Run Job name in production
INGEST_JOB_NAME=
INGEST_JOB_REGION=asia-south1

# ---- Firebase / storage ----
FIREBASE_PROJECT_ID=your-project-id
# Public Firebase web config (Firebase console -> Project settings -> Your apps -> Web app).
# Leave empty with AUTH_DISABLED=true for local dev.
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
STORE_BACKEND=file            # memory (tests) | file (local dev, backend/.data/) | firestore (Cloud Run)
AUTH_DISABLED=true            # local dev only; NEVER true in production

# ---- Guardrails ----
MAX_DAILY_LLM_CALLS_PER_USER=50
CORS_ORIGINS=["http://localhost:3000"]
